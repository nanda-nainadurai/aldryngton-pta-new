---
interface Props {
  title?: string;
  href?: string;
  class?: string;
}

const { title, href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'bg-white rounded-2xl border border-gray-100 shadow-sm',
    href && 'hover:shadow-md hover:border-primary-200 transition-all duration-200 block',
    className,
  ]}
>
  <div class="p-6">
    {title && <h3 class="text-lg font-bold text-gray-900 font-heading mb-2">{title}</h3>}
    <slot />
  </div>
</Tag>
