---
import { url } from '../utils';

interface Props {
  title: string;
  subtitle?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, subtitle, breadcrumbs } = Astro.props;
---

<section class="bg-gradient-to-br from-primary-600 to-primary-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav class="mb-4">
        <ol class="flex items-center gap-2 text-sm text-primary-200">
          <li><a href={url('/')} class="hover:text-white transition-colors">Home</a></li>
          {breadcrumbs.map((crumb, i) => (
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              {crumb.href ? (
                <a href={crumb.href} class="hover:text-white transition-colors">{crumb.label}</a>
              ) : (
                <span class="text-white">{crumb.label}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold font-heading">{title}</h1>
    {subtitle && <p class="mt-3 text-lg text-primary-100 max-w-2xl">{subtitle}</p>}
  </div>
</section>
