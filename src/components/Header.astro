---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/', children: [
    { label: 'PTA Details', href: '/about/' },
    { label: 'Contact', href: '/about/contact/' },
    { label: 'Match Funding', href: '/about/match-funding/' },
  ]},
  { label: 'Meetings', href: '/meetings/', children: [
    { label: 'Overview', href: '/meetings/' },
    { label: 'Meeting Minutes', href: '/meetings/minutes/' },
    { label: 'Financial Reports', href: '/meetings/financial/' },
    { label: 'AGM', href: '/meetings/agm/' },
  ]},
  { label: 'Fundraising', href: '/fundraisers/', children: [
    { label: 'Events & Campaigns', href: '/fundraisers/' },
    { label: 'Communications', href: '/fundraisers/communications/' },
    { label: 'Fundraising Summaries', href: '/fundraisers/summaries/' },
    { label: 'Forms & Docs', href: '/fundraisers/forms/' },
  ]},
  { label: 'Events', href: '/events/', children: [
    { label: 'Second Hand Uniform', href: '/events/uniform/' },
    { label: 'Try a Tri', href: '/events/try-a-tri/' },
    { label: "Santa's Grotto", href: '/events/santas-grotto/' },
    { label: 'Circus', href: '/events/circus/' },
  ]},
  { label: 'Pool Club', href: '/pool-club/' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <div class="w-10 h-10 bg-primary-600 rounded-xl flex items-center justify-center">
          <span class="text-white font-bold text-lg font-heading">A</span>
        </div>
        <div>
          <span class="text-lg font-bold text-gray-900 font-heading">Aldryngton</span>
          <span class="text-lg font-bold text-primary-600 font-heading"> PTA</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                isActive(item.href)
                  ? 'text-primary-700 bg-primary-50'
                  : 'text-gray-600 hover:text-primary-700 hover:bg-gray-50',
              ]}
            >
              {item.label}
              {item.children && (
                <svg class="inline-block w-4 h-4 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute left-0 top-full pt-1 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200">
                <div class="bg-white rounded-xl shadow-lg border border-gray-100 py-2 min-w-[220px]">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2 text-sm transition-colors',
                        isActive(child.href)
                          ? 'text-primary-700 bg-primary-50'
                          : 'text-gray-600 hover:text-primary-700 hover:bg-gray-50',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
      >
        <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="lg:hidden hidden pb-4">
      <div class="space-y-1 pt-2 border-t border-gray-100">
        {navItems.map((item) => (
          <div>
            <a
              href={item.href}
              class:list={[
                'block px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                isActive(item.href)
                  ? 'text-primary-700 bg-primary-50'
                  : 'text-gray-600 hover:text-primary-700 hover:bg-gray-50',
              ]}
            >
              {item.label}
            </a>
            {item.children && (
              <div class="pl-4 space-y-1">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'block px-3 py-1.5 rounded-lg text-sm transition-colors',
                      isActive(child.href)
                        ? 'text-primary-700 bg-primary-50'
                        : 'text-gray-500 hover:text-primary-700 hover:bg-gray-50',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
