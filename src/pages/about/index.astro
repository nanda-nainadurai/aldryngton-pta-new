---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import { url } from '../../utils';
import ptaContent from '../../content/pta-details.json';
---

<BaseLayout title="PTA Details">
  <PageHeader
    title="PTA Details"
    subtitle="A registered charity run by parent volunteers, working together to support Aldryngton Primary School."
    breadcrumbs={[{ label: 'About' }]}
  />

  <!-- What is the PTA -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-heading mb-6">What is the PTA?</h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-4">
          {ptaContent.intro.split('\n\n')[0]}
        </p>
        <p class="text-gray-600 text-lg leading-relaxed">
          {ptaContent.intro.split('\n\n')[1]}
        </p>
      </div>
    </div>
  </section>

  <!-- What Does the PTA Do -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-heading mb-8">What Does the PTA Do?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-gray-900 font-heading mb-2">Raises Funds</h3>
            <p class="text-gray-600">We raise funds to provide school equipment, educational resources, and enriching experiences that go beyond the standard budget.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-accent-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-gray-900 font-heading mb-2">Strengthens Connections</h3>
            <p class="text-gray-600">We strengthen the home-school connection by creating opportunities for parents and teachers to work together.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-warm-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-warm-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-gray-900 font-heading mb-2">Builds Community</h3>
            <p class="text-gray-600">We bring together staff, parents, pupils, and the wider community through fun, inclusive events throughout the year.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ways to Get Involved -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-heading mb-3">Ways to Get Involved</h2>
      <p class="text-gray-600 text-lg mb-8 max-w-2xl">No matter how much time you have, there are plenty of ways to support the PTA and make a difference.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <Card>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-primary-100 text-primary-700 rounded-lg flex items-center justify-center font-bold text-sm">1</span>
            <p class="text-gray-700 font-medium">Help at events — before, during, or after. Every pair of hands makes a difference.</p>
          </div>
        </Card>
        <Card>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-primary-100 text-primary-700 rounded-lg flex items-center justify-center font-bold text-sm">2</span>
            <p class="text-gray-700 font-medium">Attend meetings and the AGM to share and suggest fundraising ideas.</p>
          </div>
        </Card>
        <Card>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-primary-100 text-primary-700 rounded-lg flex items-center justify-center font-bold text-sm">3</span>
            <p class="text-gray-700 font-medium">Support events through your attendance and enthusiasm — bring the family along!</p>
          </div>
        </Card>
        <Card>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-primary-100 text-primary-700 rounded-lg flex items-center justify-center font-bold text-sm">4</span>
            <p class="text-gray-700 font-medium">Volunteer as a Class Rep or Committee member to take on a more active role.</p>
          </div>
        </Card>
        <Card>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-primary-100 text-primary-700 rounded-lg flex items-center justify-center font-bold text-sm">5</span>
            <p class="text-gray-700 font-medium">Share any relevant skills or contacts that could help with events or fundraising.</p>
          </div>
        </Card>
        <Card>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-primary-100 text-primary-700 rounded-lg flex items-center justify-center font-bold text-sm">6</span>
            <p class="text-gray-700 font-medium">Suggest how funds should be spent to benefit the children and the school.</p>
          </div>
        </Card>
        <Card>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-primary-100 text-primary-700 rounded-lg flex items-center justify-center font-bold text-sm">7</span>
            <p class="text-gray-700 font-medium">Make financial donations — by cash, cheque, or online — every contribution counts.</p>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Downloadable Documents -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-heading mb-3">Documents</h2>
      <p class="text-gray-600 text-lg mb-8">Download key PTA documents and policies below.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href={url('/documents/about/Aldryngton-School-PTA-Constitution-2021.pdf')} class="group flex items-center gap-4 bg-gray-50 rounded-2xl border border-gray-100 p-6 hover:border-primary-200 hover:shadow-md transition-all duration-200">
          <div class="flex-shrink-0 w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center group-hover:bg-primary-200 transition-colors">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 font-heading group-hover:text-primary-700 transition-colors">PTA Constitution 2021</h3>
            <p class="text-sm text-gray-500">Aldryngton School PTA Constitution</p>
          </div>
        </a>
        <a href={url('/documents/about/PTA-Privacy-Notice.pdf')} class="group flex items-center gap-4 bg-gray-50 rounded-2xl border border-gray-100 p-6 hover:border-primary-200 hover:shadow-md transition-all duration-200">
          <div class="flex-shrink-0 w-12 h-12 bg-accent-100 rounded-xl flex items-center justify-center group-hover:bg-accent-200 transition-colors">
            <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 font-heading group-hover:text-accent-700 transition-colors">PTA Privacy Notice</h3>
            <p class="text-sm text-gray-500">How we handle your personal data</p>
          </div>
        </a>
        <a href={url('/documents/about/PTA-Data-Protection-Policy.pdf')} class="group flex items-center gap-4 bg-gray-50 rounded-2xl border border-gray-100 p-6 hover:border-primary-200 hover:shadow-md transition-all duration-200">
          <div class="flex-shrink-0 w-12 h-12 bg-warm-100 rounded-xl flex items-center justify-center group-hover:bg-warm-200 transition-colors">
            <svg class="w-6 h-6 text-warm-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 font-heading group-hover:text-warm-600 transition-colors">Data Protection Policy</h3>
            <p class="text-sm text-gray-500">PTA Data Protection Policy</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
