---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import { url } from '../../utils';
import contactContent from '../../content/contact.json';
---

<BaseLayout title="Contact Us">
  <PageHeader
    title="Contact Us"
    subtitle="Get in touch with the Aldryngton PTA team. We'd love to hear from you."
    breadcrumbs={[
      { label: 'About', href: url('/about') },
      { label: 'Contact' },
    ]}
  />

  <!-- Main Contact -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-primary-50 to-accent-50 rounded-2xl border border-primary-100 p-8 md:p-10 mb-12">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div class="w-14 h-14 bg-primary-100 rounded-2xl flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-gray-900 font-heading mb-1">General Enquiries</h2>
            <p class="text-gray-600 mb-2">For any PTA-related questions, reach out to us at:</p>
            <a href={`mailto:${contactContent.generalEmail}`} class="text-lg font-semibold text-primary-600 hover:text-primary-800 transition-colors underline decoration-primary-300 hover:decoration-primary-600">
              {contactContent.generalEmail}
            </a>
          </div>
        </div>
      </div>

      <!-- Officers -->
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-heading mb-3">PTA Officers</h2>
      <p class="text-gray-600 text-lg mb-8">Our elected officers manage the day-to-day running of the PTA.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <Card>
          <div class="text-center">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <span class="inline-block text-xs font-semibold text-primary-700 bg-primary-100 rounded-full px-3 py-1 mb-3">Chair</span>
            <h3 class="text-lg font-bold text-gray-900 font-heading">{contactContent.officers[0].name}</h3>
            <a href={`mailto:${contactContent.officers[0].email}`} class="text-sm text-primary-600 hover:text-primary-800 transition-colors break-all">
              {contactContent.officers[0].email}
            </a>
          </div>
        </Card>
        <Card>
          <div class="text-center">
            <div class="w-16 h-16 bg-accent-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <span class="inline-block text-xs font-semibold text-accent-700 bg-accent-100 rounded-full px-3 py-1 mb-3">Vice Chair</span>
            <h3 class="text-lg font-bold text-gray-900 font-heading">{contactContent.officers[1].name}</h3>
            <a href={`mailto:${contactContent.officers[1].email}`} class="text-sm text-accent-600 hover:text-accent-800 transition-colors break-all">
              {contactContent.officers[1].email}
            </a>
          </div>
        </Card>
        <Card>
          <div class="text-center">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <span class="inline-block text-xs font-semibold text-primary-700 bg-primary-100 rounded-full px-3 py-1 mb-3">Treasurer</span>
            <h3 class="text-lg font-bold text-gray-900 font-heading">{contactContent.officers[2].name}</h3>
            <a href={`mailto:${contactContent.officers[2].email}`} class="text-sm text-primary-600 hover:text-primary-800 transition-colors break-all">
              {contactContent.officers[2].email}
            </a>
          </div>
        </Card>
        <Card>
          <div class="text-center">
            <div class="w-16 h-16 bg-accent-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <span class="inline-block text-xs font-semibold text-accent-700 bg-accent-100 rounded-full px-3 py-1 mb-3">Secretary</span>
            <h3 class="text-lg font-bold text-gray-900 font-heading">{contactContent.officers[3].name}</h3>
            <a href={`mailto:${contactContent.officers[3].email}`} class="text-sm text-accent-600 hover:text-accent-800 transition-colors break-all">
              {contactContent.officers[3].email}
            </a>
          </div>
        </Card>
      </div>

      <!-- Additional Contacts -->
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-heading mb-3">Additional Contacts</h2>
      <p class="text-gray-600 text-lg mb-8">Reach out to specific teams for year group or team-related queries.</p>
      <div class="grid sm:grid-cols-2 gap-6 mb-16">
        <Card>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading">Year Links</h3>
              <a href="mailto:yearlinks@aldryngtonpta.com" class="text-sm text-primary-600 hover:text-primary-800 transition-colors">
                yearlinks@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
        <Card>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-accent-100 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading">PTA Teams</h3>
              <a href="mailto:ptateams@aldryngtonpta.com" class="text-sm text-accent-600 hover:text-accent-800 transition-colors">
                ptateams@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
      </div>

      <!-- Event Team Contacts -->
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-heading mb-3">Event Team Contacts</h2>
      <p class="text-gray-600 text-lg mb-8">Get in touch with the teams behind our most popular events.</p>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <Card>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-warm-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-lg">🧁</span>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading text-sm">Bake Sales</h3>
              <a href="mailto:cakesales@aldryngtonpta.com" class="text-xs text-primary-600 hover:text-primary-800 transition-colors break-all">
                cakesales@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
        <Card>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-accent-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-lg">🪩</span>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading text-sm">Discos</h3>
              <a href="mailto:disco@aldryngtonpta.com" class="text-xs text-primary-600 hover:text-primary-800 transition-colors break-all">
                disco@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
        <Card>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-lg">🥚</span>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading text-sm">Egg Hunts</h3>
              <a href="mailto:egghunt@aldryngtonpta.com" class="text-xs text-primary-600 hover:text-primary-800 transition-colors break-all">
                egghunt@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
        <Card>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-accent-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-lg">🏊</span>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading text-sm">Pool Club</h3>
              <a href="mailto:pool@aldryngtonpta.com" class="text-xs text-primary-600 hover:text-primary-800 transition-colors break-all">
                pool@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
        <Card>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-warm-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-lg">🧠</span>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading text-sm">Quiz Nights</h3>
              <a href="mailto:quiz@aldryngtonpta.com" class="text-xs text-primary-600 hover:text-primary-800 transition-colors break-all">
                quiz@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
        <Card>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-lg">👕</span>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading text-sm">Uniforms</h3>
              <a href="mailto:uniform@aldryngtonpta.com" class="text-xs text-primary-600 hover:text-primary-800 transition-colors break-all">
                uniform@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
        <Card>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-warm-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-lg">🎅</span>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading text-sm">Santa Runs</h3>
              <a href="mailto:santarun@aldryngtonpta.com" class="text-xs text-primary-600 hover:text-primary-800 transition-colors break-all">
                santarun@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
        <Card>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-accent-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-lg">🏃</span>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading text-sm">Try a Tri</h3>
              <a href="mailto:tryatri@aldryngtonpta.com" class="text-xs text-primary-600 hover:text-primary-800 transition-colors break-all">
                tryatri@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
        <Card>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-lg">☕</span>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 font-heading text-sm">Coffee Mornings</h3>
              <a href="mailto:coffeemornings@aldryngtonpta.com" class="text-xs text-primary-600 hover:text-primary-800 transition-colors break-all">
                coffeemornings@aldryngtonpta.com
              </a>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>
</BaseLayout>
