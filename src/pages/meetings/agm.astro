    { date: '16 Sep 2009', title: "PTA AGM — Treasurer\u2019s Report" },
    { date: '16 Sep 2009', title: 'PTA AGM — Minutes' },
  ],
};
---

<BaseLayout title="Annual General Meeting">
  <PageHeader
    title="Annual General Meeting"
    breadcrumbs={[
      { label: 'Meetings', href: url('/meetings') },
      { label: 'AGM' },
    ]}
  />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <p class="text-gray-700 text-lg leading-relaxed mb-10">
      The Annual General Meeting is held each September. It is the occasion when the committee is
      elected, the annual accounts are presented and key decisions about the PTA's direction are
      made. All parents and carers are encouraged to attend.
    </p>

    <!-- Recent AGMs -->
    <h2 class="text-2xl font-bold text-gray-900 font-heading mb-6">Recent AGMs (2023 – 2025)</h2>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm divide-y divide-gray-100 mb-10">
      {recentAGMs.map((item) => (
        <a href="#" class="flex items-center gap-4 px-5 py-4 hover:bg-primary-50 transition-colors first:rounded-t-2xl last:rounded-b-2xl">
          <div class="flex-shrink-0 text-warm-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 3v6h6" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-gray-900">{item.title}</p>
            <p class="text-sm text-gray-500">{item.date}</p>
          </div>
          <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </div>

    <!-- Older AGMs -->
    <details class="group bg-white rounded-2xl border border-gray-100 shadow-sm">
      <summary class="flex items-center justify-between cursor-pointer px-5 py-4 text-lg font-bold text-gray-900 font-heading hover:bg-gray-50 rounded-2xl transition-colors">
        <span>Older AGMs (2009 – 2022)</span>
        <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-5 pb-5 space-y-6">
        {Object.entries(olderAGMs).map(([year, items]) => (
          <div>
            <h3 class="text-sm font-bold text-warm-600 uppercase tracking-wide mb-2">{year}</h3>
            <div class="divide-y divide-gray-100">
              {items.map((item) => (
                <a href="#" class="flex items-center gap-3 py-2.5 hover:bg-primary-50 px-3 -mx-3 rounded-lg transition-colors">
                  <div class="flex-shrink-0 text-gray-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 3v6h6" />
                    </svg>
                  </div>
                  <span class="text-sm text-gray-700">{item.title}</span>
                  <span class="text-sm text-gray-400">— {item.date}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </details>
  </section>
</BaseLayout>
