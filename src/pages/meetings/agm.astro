---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../utils';

const recentAGMs = [
  { date: '17 Sep 2025', title: "PTA AGM — Treasurer\u2019s Report", file: '20250917-pta-agm-treasurers-report' },
  { date: '17 Sep 2025', title: 'PTA AGM — Minutes', file: '20250917-pta-agm-minutes' },
  { date: '18 Sep 2024', title: 'PTA AGM — Minutes', file: '20240918-pta-agm-minutes' },
  { date: '01 Nov 2023', title: 'PTA EGM — Minutes', file: '20231101-pta-egm-minutes' },
  { date: '09 Oct 2023', title: "PTA AGM — Treasurer\u2019s Report", file: '20231009-pta-agm-treasurers-report' },
  { date: '09 Oct 2023', title: 'PTA AGM — Minutes', file: '20231009-pta-agm-minutes' },
];

const olderAGMs: Record<string, { date: string; title: string }[]> = {
  '2022': [
    { date: '21 Sep 2022', title: "PTA AGM — Treasurer\u2019s Report" },
    { date: '21 Sep 2022', title: 'PTA AGM — Minutes' },
  ],
  '2021': [
    { date: '22 Sep 2021', title: "PTA AGM — Treasurer\u2019s Report" },
