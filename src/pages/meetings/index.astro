---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../utils';
import meetingsData from '../../content/meetings.json';
---

<BaseLayout title="PTA Meetings">
  <PageHeader
    title="PTA Meetings"
    subtitle="Your voice matters — come along and help shape our school community"
    breadcrumbs={[{ label: 'Meetings' }]}
  />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="prose prose-lg max-w-none mb-10">
      <p class="text-gray-700 text-lg leading-relaxed">
        {meetingsData.content}
      </p>
    </div>

    <!-- Next Meeting Highlight -->
    <div class="bg-gradient-to-r from-primary-50 to-primary-100 border border-primary-200 rounded-2xl p-6 sm:p-8 mb-12">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 bg-primary-600 text-white rounded-xl p-3">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-bold text-primary-900 font-heading mb-1">Date of Next Meeting</h2>
          <p class="text-2xl font-extrabold text-primary-700 font-heading">{meetingsData.nextMeetingDate}</p>
          <p class="text-sm text-primary-600 mt-2">All parents and carers are welcome to attend.</p>
        </div>
      </div>
    </div>

    <!-- Sub-page Links -->
    <h2 class="text-2xl font-bold text-gray-900 font-heading mb-6">Meeting Resources</h2>
    <div class="grid sm:grid-cols-3 gap-5 mb-12">
      <a href={url('/meetings/minutes')} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-primary-200 transition-all duration-200 p-6">
        <div class="bg-primary-100 text-primary-700 rounded-xl w-12 h-12 flex items-center justify-center mb-4 group-hover:bg-primary-200 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 font-heading mb-1">Meeting Minutes</h3>
        <p class="text-sm text-gray-600">Read the minutes from past PTA meetings.</p>
      </a>

      <a href={url('/meetings/financial')} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-primary-200 transition-all duration-200 p-6">
        <div class="bg-accent-100 text-accent-700 rounded-xl w-12 h-12 flex items-center justify-center mb-4 group-hover:bg-accent-200 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 font-heading mb-1">Financial Reports</h3>
        <p class="text-sm text-gray-600">View treasurer's reports and accounts.</p>
      </a>

      <a href={url('/meetings/agm')} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-primary-200 transition-all duration-200 p-6">
        <div class="bg-warm-100 text-warm-500 rounded-xl w-12 h-12 flex items-center justify-center mb-4 group-hover:bg-warm-200 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 font-heading mb-1">Annual General Meeting</h3>
        <p class="text-sm text-gray-600">AGM minutes, reports and key decisions.</p>
      </a>
    </div>

    <!-- Encouragement -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 sm:p-8">
      <h2 class="text-xl font-bold text-gray-900 font-heading mb-3">Everyone Is Welcome</h2>
      <p class="text-gray-700 leading-relaxed mb-4">
        Our meetings are relaxed and friendly. Whether you have ten minutes or ten hours to give,
        we would love to see you there. It's a great way to find out what's going on, share your
        ideas and help make a real difference to every child at Aldryngton.
      </p>
      <p class="text-gray-700 leading-relaxed">
        Meetings are usually held in the school hall during the evening. We aim to keep them short
        and productive so you can be home in time for a cup of tea! Keep an eye on our
        communications for exact times and any changes.
      </p>
    </div>
  </section>
</BaseLayout>
