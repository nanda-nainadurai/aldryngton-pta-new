---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const pricing = [
  { item: 'Aldryngton jumpers / cardigans', price: '\u00A31.50\u2013\u00A33' },
  { item: 'Other jumpers / cardigans', price: '\u00A31.50' },
  { item: 'Shirts / polo shirts', price: '50p\u2013\u00A31' },
  { item: 'Trousers', price: '\u00A31.50' },
  { item: 'Skirts / Skorts', price: '\u00A31.50' },
  { item: 'Shorts', price: '\u00A31.50' },
  { item: 'Dresses', price: '\u00A31.50' },
  { item: 'PE Kit', price: '50p' },
];
---

<BaseLayout title="Second Hand Uniform">
  <PageHeader
    title="Second Hand Uniform"
    breadcrumbs={[
      { label: 'Events', href: '/events/' },
      { label: 'Uniform' },
    ]}
  />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-12">

    <!-- How to Donate -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 font-heading mb-4">How to Donate</h2>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 md:p-8">
        <p class="text-gray-700 leading-relaxed">
          Donations of clean, outgrown uniform items are appreciated. We can take Aldryngton
          jumpers, cardigans, trousers, shorts, shirts, skirts, dresses and summer dresses.
          Donations should please be laundered and name labels removed.
        </p>
      </div>
    </section>

    <!-- How to Buy -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 font-heading mb-4">How to Buy</h2>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 md:p-8">
        <p class="text-gray-700 leading-relaxed">
          Second Hand Uniform Sales are held several times a year. Email
          <a href="mailto:uniform@aldryngtonpta.com" class="text-primary-600 hover:text-primary-700 font-semibold underline underline-offset-2">
            uniform@aldryngtonpta.com
          </a>
          to check availability.
        </p>
      </div>
    </section>

    <!-- Pricing -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 font-heading mb-4">Pricing</h2>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <table class="w-full text-left">
          <thead>
            <tr class="bg-primary-600 text-white">
              <th class="px-6 py-4 text-sm font-semibold uppercase tracking-wider">Item</th>
              <th class="px-6 py-4 text-sm font-semibold uppercase tracking-wider text-right">Price</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {pricing.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-6 py-4 text-gray-700">{row.item}</td>
                <td class="px-6 py-4 text-gray-900 font-semibold text-right">{row.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Lost Property -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 font-heading mb-4">Lost Property</h2>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 md:p-8">
        <p class="text-gray-700 leading-relaxed">
          Lost property accumulates very quickly at school. Please ensure all items of clothing
          and belongings are clearly named. Unclaimed items are regularly sorted through and any
          unnamed items may be added to the second hand uniform stock.
        </p>
      </div>
    </section>

    <!-- Can You Help? -->
    <section>
      <div class="bg-gradient-to-br from-primary-50 to-accent-50 rounded-2xl border border-primary-100 p-6 md:p-8">
        <h2 class="text-2xl font-bold text-gray-900 font-heading mb-3">Can You Help?</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          We are always looking for volunteers to help sort, organise and sell second hand
          uniform. If you can spare some time, we would love to hear from you.
        </p>
        <a
          href="mailto:uniform@aldryngtonpta.com"
          class="inline-flex items-center gap-2 bg-primary-600 text-white px-5 py-2.5 rounded-lg font-semibold hover:bg-primary-700 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Get in touch
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
