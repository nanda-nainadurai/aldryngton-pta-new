---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const events = [
  {
    title: 'Second Hand Uniform',
    href: '/events/uniform/',
    description: 'Pick up affordable school uniform items or donate outgrown clothing. Sales are held several times a year.',
    icon: '👕',
  },
  {
    title: 'Try a Tri',
    href: '/events/try-a-tri/',
    description: 'A fun triathlon for Aldryngton pupils featuring swimming, cycling and running. Open to all year groups.',
    icon: '🏊',
  },
  {
    title: "Santa's Grotto",
    href: '/events/santas-grotto/',
    description: 'Experience the magic of Christmas with a visit to Santa at Aldryngton. Every child receives a special gift.',
    icon: '🎅',
  },
  {
    title: 'Circus',
    href: '/events/circus/',
    description: "Happy's Circus brings an all-human, family-friendly spectacular to Aldryngton for a magical evening.",
    icon: '🎪',
  },
];
---

<BaseLayout title="Events">
  <PageHeader title="Events" subtitle="Fun activities for the whole school community" />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-6">
      {events.map((event) => (
        <a
          href={event.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-primary-200 transition-all duration-200 overflow-hidden"
        >
          <div class="p-6 md:p-8">
            <div class="flex items-start gap-4">
              <span class="text-4xl flex-shrink-0" aria-hidden="true">{event.icon}</span>
              <div>
                <h2 class="text-xl font-bold text-gray-900 font-heading group-hover:text-primary-700 transition-colors">
                  {event.title}
                </h2>
                <p class="mt-2 text-gray-600 leading-relaxed">{event.description}</p>
                <span class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-primary-600 group-hover:text-primary-700">
                  Learn more
                  <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
