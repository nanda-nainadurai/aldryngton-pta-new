---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../utils';
---

<BaseLayout title="Forms, Templates & Documents">
  <PageHeader
    title="Forms, Templates & Documents"
    breadcrumbs={[
      { label: 'Fundraising', href: url('/fundraisers/') },
      { label: 'Forms & Docs' },
    ]}
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">

    <div class="max-w-2xl mx-auto">
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 md:p-12 text-center">
        <!-- Info Icon -->
        <div class="w-16 h-16 rounded-full bg-accent-50 flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>

        <h2 class="text-xl md:text-2xl font-bold text-gray-900 font-heading mb-3">Page Being Updated</h2>
        <p class="text-gray-600 leading-relaxed mb-6">
          This page is being updated. Forms, templates, and documents for PTA fundraising activities will be available here soon. Please check back later or contact us for information.
        </p>

        <a
          href="mailto:ptaofficers@aldryngtonpta.com"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 text-white font-semibold rounded-xl hover:bg-primary-700 transition-colors text-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          ptaofficers@aldryngtonpta.com
        </a>
      </div>

      <!-- Back Link -->
      <div class="mt-8">
        <a
          href={url('/fundraisers/')}
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Fundraising
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
