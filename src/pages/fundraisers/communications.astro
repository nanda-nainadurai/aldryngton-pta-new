---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<BaseLayout title="Communications">
  <PageHeader
    title="Communications"
    breadcrumbs={[
      { label: 'Fundraising', href: '/fundraisers/' },
      { label: 'Communications' },
    ]}
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-10">

    <!-- Introduction -->
    <section>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 md:p-8">
        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-gray-900 font-heading mb-2">PTA Communications</h2>
            <p class="text-gray-700 leading-relaxed">
              This is where we share PTA communications, including newsletters, event announcements, and important updates. We aim to keep all parents and carers informed about PTA activities, fundraising campaigns, and how funds are being used to benefit our children.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stay Connected -->
    <section>
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-heading mb-4">Stay Connected</h2>
      <div class="grid gap-6 sm:grid-cols-2">

        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-accent-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 font-heading mb-1">School Calendar</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-3">
                Keep up to date with all school and PTA events via the official school calendar.
              </p>
              <a
                href="https://aldryngton.wokingham.sch.uk/home/parents/calendar/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors"
              >
                View School Calendar
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 font-heading mb-1">Contact the PTA</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-3">
                Have a question or suggestion? Get in touch with the PTA team directly.
              </p>
              <div class="space-y-2">
                <a
                  href="mailto:ptaofficers@aldryngtonpta.com"
                  class="flex items-center gap-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  ptaofficers@aldryngtonpta.com
                </a>
                <a
                  href="mailto:ptaevents@aldryngtonpta.com"
                  class="flex items-center gap-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  ptaevents@aldryngtonpta.com
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Back Link -->
    <div>
      <a
        href="/fundraisers/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Fundraising
      </a>
    </div>

  </div>
</BaseLayout>
